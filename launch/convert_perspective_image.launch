<?xml version="1.0"?>
<launch>

  <node pkg="omni_lidar_camera_fusion" name="convert_perspective_node" type="convert_perspective_node.py" output="screen" args="$(find omni_lidar_camera_fusion)/scripts/nodes/convert_perspective_node.py"/>

  <node type="rviz" name="rviz" pkg="rviz" args="-d $(find omni_lidar_camera_fusion)/rviz/convert_perspective_image.rviz" />

</launch>
